{
  "name": "@sugukuru/mcp-houjin-bangou",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Japan's National Corporate Number (houjin-bangou) and Qualified Invoice Issuer lookup published by the National Tax Agency of Japan, with deterministic company-name normalization.",
  "license": "MIT",
  "author": "Sugukuru K.K. (Kagoshima) <info@sugu-kuru.co.jp>",
  "homepage": "https://github.com/SUGUKURU-CO-LTD/mcp-houjin-bangou#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SUGUKURU-CO-LTD/mcp-houjin-bangou.git"
  },
  "bugs": {
    "url": "https://github.com/SUGUKURU-CO-LTD/mcp-houjin-bangou/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "houjin-bangou",
    "corporate-number",
    "invoice-issuer",
    "qualified-invoice",
    "nta",
    "japan",
    "kyc",
    "claude",
    "anthropic",
    "cursor",
    "sugukuru"
  ],
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "mcp-houjin-bangou": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm build:server && pnpm build:ui && pnpm build:csp",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui:card": "UI_ENTRY=corporate-card vite build",
    "build:ui:results": "UI_ENTRY=search-results vite build",
    "build:ui": "pnpm build:ui:card && pnpm build:ui:results",
    "build:csp": "tsx scripts/compute-csp-hashes.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "bench": "tsx benchmarks/run.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "health-check": "tsx scripts/api-id-keepalive.ts",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "smoke:live": "tsx scripts/nta-live-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.16",
    "drizzle-orm": "0.45.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "pg": "8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tinybench": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
