{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "jp.co.sugu-kuru/mcp-houjin-bangou",
  "description": "Read-only MCP server for Japan NTA Corporate Numbers and Qualified Invoice Issuers (T-numbers).",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/SUGUKURU-CO-LTD/mcp-houjin-bangou",
    "source": "github"
  },
  "websiteUrl": "https://sugu-kuru.co.jp/mcp/houjin",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://houjin.mcp.sugu-kuru.co.jp/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@sugukuru/mcp-houjin-bangou",
      "version": "1.0.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:3001/mcp"
      },
      "environmentVariables": [
        {
          "name": "NTA_APPLICATION_ID",
          "description": "National Tax Agency Corporate Number Web-API Application ID (required for local nta_api mode).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
