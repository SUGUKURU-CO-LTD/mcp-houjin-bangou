exports[`MCP Contract Snapshot Tests (SLA2-328) > prompts/list snapshots and invariant contracts > matches snapshot for prompts/list 1`] = `
{
  "prompts": [
    {
      "arguments": [
        {
          "description": "対象の会社名・商号 / Target company name",
          "name": "company_name",
          "required": true,
        },
        {
          "description": "名寄せの絞り込みに用いる都道府県や市区町村 / Optional location hint (prefecture or city)",
          "name": "location_hint",
          "required": false,
        },
      ],
      "description": "会社名から法人番号や公表情報を検索・照合し、社内データベース用の取引先企業マスタレコードを生成します。※個人の連絡先情報は入力しないでください。",
      "name": "company-master-record",
      "title": "Company master record generation from company name",
    },
    {
      "arguments": [
        {
          "description": "企業名一覧。1行に1社、最大20社 / Company name list (one per line, max 20)",
          "name": "company_list_text",
          "required": true,
        },
      ],
      "description": "企業名のリストから法人番号・所在地・法人種別を一括検索し、企業リストを補完します（1回あたり最大20社）。※個人の連絡先情報は入力しないでください。",
      "name": "sales-list-enrichment",
      "title": "Bulk sales list enrichment via NTA corporate number (max 20 companies)",
    },
    {
      "arguments": [
        {
          "description": "名寄せ対象の会社名 / Target company name for deduplication",
          "name": "target_company_name",
          "required": true,
        },
        {
          "description": "照合用の住所 / Optional current address for matching",
          "name": "current_address",
          "required": false,
        },
      ],
      "description": "既存の顧客・取引先マスタの社名・住所から、国税庁の公表法人情報と突合して正式名称・法人番号を特定し、名寄せ・表記ゆれの統一を支援します。※個人の連絡先情報は入力しないでください。",
      "name": "customer-master-dedup",
      "title": "Customer master dedup via NTA corporate number",
    },
  ],
}
`;

