# 国税庁 法人番号 Web-API Ver.4.0 アプリケーション ID
# NTA houjin-bangou Web-API application ID (required)
# ID Aplikasi Web-API Nomor Perusahaan NTA (wajib)
#
# 発行方法: https://www.invoice-kohyo.nta.go.jp/web-api/pre-reg/
# (適格請求書発行事業者公表サイト経由、第一編 §5.1)
# 同じ ID で適格請求書発行事業者 API も利用可能 (別添1 第2条第7号)
NTA_APPLICATION_ID=

# API エンドポイント (通常はデフォルト値のまま)
# 本番: https://api.houjin-bangou.nta.go.jp/4
# 検証環境: 国税庁から別途案内 (第一編 §7)
NTA_BASE_URL=https://api.houjin-bangou.nta.go.jp/4

# サーバーポート
PORT=3001

# ログレベル (fatal / error / warn / info / debug / trace)
LOG_LEVEL=info

# 実行環境 (development / test / production)
NODE_ENV=development

# レート制限 (国税庁 API への秒間リクエスト数、保守的に 1 RPS 推奨)
NTA_RATE_LIMIT_RPS=1

# API タイムアウト (ms)
NTA_TIMEOUT_MS=8000

# データ参照元 (web-api / db、既定: web-api)
# DATA_SOURCE=web-api

# PostgreSQL 接続 URL (既定: なし。DATA_SOURCE=db のとき必須)
# DATABASE_URL=postgresql://user:password@localhost:5432/houjin

# カンマ区切りの許可 Origin 一覧 (既定: 空文字。Origin ヘッダーがある場合のみ照合し、不一致は HTTP 403 を返す)
# ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Express の trust proxy ホップ数 (既定: 1)
# TRUST_PROXY=1

# IP 単位レート制限の集計ウィンドウ (ミリ秒、既定: 60000)
# RATE_LIMIT_WINDOW_MS=60000

# 集計ウィンドウあたりの 1 IP 最大リクエスト数 (既定: 60)
# RATE_LIMIT_MAX_REQUESTS=60

# 取り込み検証: 空データでの入れ替えを防ぐ最小件数 (既定: 1)
# INGEST_MIN_RECORD_COUNT=1

# 取り込み検証: 稼働中の版の件数に対する最小許容比率 (0〜1、既定: 0.9)
# INGEST_MIN_RECORD_COUNT_RATIO=0.9

# 取り込み検証: 法人番号 CSV において解析できない行の最大許容比率 (0〜1、既定: 0.01)
# INGEST_MAX_INVALID_ROW_RATIO=0.01
