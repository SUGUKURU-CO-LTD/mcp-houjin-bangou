# 国税庁 法人番号システム Web-API Ver.4.0 アプリケーション ID (DATA_SOURCE=web-api 時に必須)
# NTA Corporate Number Web-API Application ID (required when DATA_SOURCE=web-api)
#
# 発行手続: https://www.houjin-bangou.nta.go.jp/webapi/tetuzuki.html
#           (届出フォーム: https://www.invoice-kohyo.nta.go.jp/web-api/pre-reg/)
# ※ 注意: ローカルの DATA_SOURCE=web-api モードで動作するのは法人番号照会・検索ツールのみです。
#    適格請求書発行事業者の照会 (lookup_invoice_issuer) は PostgreSQL 公表データ (DATA_SOURCE=db)
#    またはホスト版 (https://houjin.mcp.sugu-kuru.co.jp/mcp) が必要であり、web-api モードでは DATA_UNAVAILABLE を返します。
NTA_APPLICATION_ID=

# 国税庁 法人番号 Web-API エンドポイント (通常はデフォルト値のまま)
# 本番: https://api.houjin-bangou.nta.go.jp/4
# 検証環境: 国税庁から別途案内 (第一編 §7)
NTA_BASE_URL=https://api.houjin-bangou.nta.go.jp/4

# HTTP サーバー待受ポート
PORT=3001

# ログレベル (fatal / error / warn / info / debug / trace)
LOG_LEVEL=info

# 実行環境 (development / test / production)
NODE_ENV=development

# レート制限 (国税庁 Web-API への秒間最大リクエスト数、保守的に 1 RPS 推奨)
NTA_RATE_LIMIT_RPS=1

# 国税庁 Web-API タイムアウト (ミリ秒)
NTA_TIMEOUT_MS=8000

# データ参照元 (web-api / db、既定: web-api)
# DATA_SOURCE=web-api

# PostgreSQL 接続 URL (既定: なし。DATA_SOURCE=db のとき必須。lookup_invoice_issuer をセルフホストで使う場合に設定)
# DATABASE_URL=postgresql://houjin_reader:password@localhost:5432/corp_check

# カンマ区切りの許可 Origin 一覧 (既定: 空文字。Origin ヘッダーがある場合のみ照合し、不一致は HTTP 403 を返す)
# ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Express の trust proxy ホップ数 (既定: 1)
# TRUST_PROXY=1

# IP 単位レート制限の集計ウィンドウ (ミリ秒、既定: 60000)
# RATE_LIMIT_WINDOW_MS=60000

# 集計ウィンドウあたりの 1 IP 最大リクエスト数 (既定: 60)
# RATE_LIMIT_MAX_REQUESTS=60

# 取り込み検証: 空データでの入れ替えを防ぐ最小件数 (既定: 1)
# INGEST_MIN_RECORD_COUNT=1

# 取り込み検証: 稼働中の版の件数に対する最小許容比率 (0〜1、既定: 0.9)
# INGEST_MIN_RECORD_COUNT_RATIO=0.9

# 取り込み検証: 法人番号 CSV において解析できない行の最大許容比率 (0〜1、既定: 0.01)
# INGEST_MAX_INVALID_ROW_RATIO=0.01

# ChatGPT Apps ドメイン確認用チャレンジトークン (既定: 空文字。未設定時は GET /.well-known/openai-apps-challenge が 404 を返す)
# OPENAI_APPS_CHALLENGE_TOKEN=
